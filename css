@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');

:root {
    --background: #0b0b0d;
    --surface: #111113;
    --card: #1a1a1e;
    --text: #ffffff;
    --muted: #a1a1aa;
    --accent: #ff6b35;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html { scroll-behavior: smooth; }

body {
    background: var(--background);
    color: var(--text);
    font-family: 'Inter', sans-serif;
}

header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(11, 11, 13, 0.95);
    border-bottom: 1px solid #252529;
    backdrop-filter: blur(12px);
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 22px 5%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 25px;
    font-weight: 800;
    color: white;
    text-decoration: none;
}

.logo img {
    height: 55px;
    width: auto;
    object-fit: contain;
    display: block;
}
.logo span, h1 span, h2 span { color: var(--accent); }

.nav-links {
    display: flex;
    align-items: center;
    gap: 30px;
    list-style: none;
}

.nav-links a {
    color: white;
    text-decoration: none;
    font-size: 14px;
    transition: color 0.3s ease;
}

.nav-links a:hover { color: var(--accent); }

.nav-links .contact-btn {
    border: 1px solid var(--accent);
    padding: 11px 20px;
    border-radius: 30px;
}

.menu-toggle {
    display: none;
    background: none;
    border: none;
    color: white;
    font-size: 27px;
    cursor: pointer;
}

.hero {
    min-height: 85vh;
    padding: 130px 8% 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    background:
        radial-gradient(ellipse at 80% 40%, #492014 0%, transparent 40%),
        var(--background);
}

.eyebrow {
    color: var(--accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    margin-bottom: 25px;
}

.hero h1 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(60px, 10vw, 125px);
    line-height: 0.95;
    font-weight: 700;
    letter-spacing: -5px;
}

.hero-description {
    max-width: 550px;
    color: var(--muted);
    line-height: 1.8;
    margin: 30px 0;
}

.primary-btn {
    display: inline-block;
    width: fit-content;
    padding: 15px 28px;
    background: var(--accent);
    color: white;
    text-decoration: none;
    font-weight: 700;
    border-radius: 4px;
    transition: 0.3s ease;
}

.primary-btn:hover {
    background: white;
    color: var(--background);
    transform: translateY(-3px);
}

.hero-bottom {
    margin-top: 90px;
    color: #777;
    font-size: 11px;
    letter-spacing: 2px;
}

.section {
    padding: 100px 8%;
    max-width: 1400px;
    margin: auto;
}

.section h2 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: clamp(36px, 5vw, 65px);
    margin-bottom: 25px;
}

.section-description {
    max-width: 650px;
    color: var(--muted);
    line-height: 1.9;
}

.services {
    background: var(--surface);
    max-width: none;
}

.services h2, .services > .eyebrow, .services > .service-grid {
    max-width: 1200px;
    margin-left: auto;
    margin-right: auto;
}

.service-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 45px;
}

.service-card {
    padding: 35px;
    min-height: 180px;
    background: var(--card);
    border: 1px solid #29292d;
    transition: 0.3s ease;
}

.service-card:hover {
    border-color: var(--accent);
    transform: translateY(-5px);
}

.service-card h3 {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 19px;
    margin-bottom: 18px;
}

.service-card p {
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
}

.portfolio-placeholder {
    margin-top: 40px;
    padding: 100px 20px;
    text-align: center;
    background: linear-gradient(135deg, #242428, #141416);
    color: var(--muted);
    letter-spacing: 3px;
    font-size: 13px;
}

.contact { text-align: center; }
.contact .primary-btn { margin-top: 20px; }

footer {
    border-top: 1px solid #29292d;
    padding: 30px 8%;
    display: flex;
    justify-content: space-between;
    gap: 15px;
    color: #777;
    font-size: 12px;
}

@media (max-width: 768px) {
    .menu-toggle { display: block; }

    .nav-links {
        display: none;
        position: absolute;
        top: 70px;
        left: 0;
        width: 100%;
        padding: 25px;
        background: #111113;
        flex-direction: column;
    }

    .nav-links.active { display: flex; }
    .hero { min-height: 75vh; padding: 100px 7% 40px; }
    .hero h1 { letter-spacing: -3px; }
    .service-grid { grid-template-columns: 1fr; }
    .section { padding: 75px 7%; }
    footer { flex-direction: column; text-align: center; }
}
